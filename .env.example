# Public site URL used for metadata / Open Graph (optional)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Telemetry source, inlined at build time (rebuild after changing it).
#   simulated      — default. Simulated helmet, bike module and phone; simulator + fault injection enabled.
#   web-bluetooth  — stub. Detects Web Bluetooth support only; GATT pairing is not implemented yet, so all
#                    devices show Offline/Unavailable and the simulator controls are disabled.
# Any other value (including the planned "native-bridge") falls back to "simulated".
NEXT_PUBLIC_TELEMETRY_SOURCE=simulated
